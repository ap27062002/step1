# Tavily search API — powers the startup & funding discovery feed on the Jobs page.
# Without this, that section falls back to sample data.
#
# Sign up free at https://tavily.com (1,000 searches/month free tier) and copy your API key.
TAVILY_API_KEY=

# Hunter.io — finds executive/contact emails at a startup's domain for the
# "Reach out" feature on each search result. Without this, it falls back to
# sample contacts.
#
# Sign up free at https://hunter.io (25 domain searches/month free tier) and copy your API key.
HUNTER_API_KEY=
