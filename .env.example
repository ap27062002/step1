# Local SQLite database used for the application tracker in development
# (created automatically by `prisma migrate dev`). Not used if TURSO_DATABASE_URL is set.
DATABASE_URL="file:./dev.db"

# Hosted Turso (libSQL) database — required in production (e.g. on Vercel),
# since serverless functions can't persist a local SQLite file.
# Create a free database at https://turso.tech, then:
#   turso db create job-tracker
#   turso db show job-tracker --url          -> TURSO_DATABASE_URL
#   turso db tokens create job-tracker        -> TURSO_AUTH_TOKEN
# Set both as Environment Variables in the Vercel dashboard (Settings -> Environment Variables).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Adzuna job search API (free tier). Sign up at https://developer.adzuna.com/
# Without these, the Jobs page falls back to sample data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Two-letter country code for Adzuna search (e.g. "in", "us", "gb"). Defaults to "in".
ADZUNA_COUNTRY=in
