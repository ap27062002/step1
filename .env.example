# SQLite database used for the application tracker (created automatically by `prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# Adzuna job search API (free tier). Sign up at https://developer.adzuna.com/
# Without these, the Jobs page falls back to sample data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Two-letter country code for Adzuna search (e.g. "in", "us", "gb"). Defaults to "in".
ADZUNA_COUNTRY=in
